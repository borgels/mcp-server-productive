# --- Connection (required) -------------------------------------------------
# A Productive API token. Create it in Productive under Settings -> API
# integrations. The token inherits the permissions of the person who created it,
# and stops working when that person is deactivated — so use a service account,
# not a leaver's login.
PRODUCTIVE_API_TOKEN=

# The numeric organization id, visible in your Productive URL. Productive
# rejects every request without it. One instance of this server serves exactly
# one organization: run a second instance for a second organization rather than
# letting a caller choose.
PRODUCTIVE_ORGANIZATION_ID=

# Override only for a local mock. Credentials are refused over plain http://
# unless the host is loopback.
# PRODUCTIVE_BASE_URL=https://api.productive.io/api/v2
# PRODUCTIVE_TIMEOUT_MS=30000

# --- What this instance may do ---------------------------------------------
# Everything is off by default: a read-only server is the useful, safe default.
#
# Master switch. Nothing is mutated without it.
# PRODUCTIVE_ENABLE_WRITES=true

# Money, pricing, payroll, and documents a customer receives: invoices, line
# items, payments, bills, expenses, purchase orders, proposals, contracts,
# prices, rate cards, salaries, overheads, tax rates, bank accounts,
# subsidiaries. Separate from ordinary writes because issuing an invoice is not
# the same kind of decision as moving a task.
# PRODUCTIVE_ENABLE_FINANCIALS=true

# Access and organization-wide configuration: people, memberships, permission
# sets, teams, invitations, custom fields, webhooks, integrations, approval
# policies, time-tracking policies.
# PRODUCTIVE_ENABLE_ADMIN=true

# Deletes, on top of the tier gate. Off even when writes are on: only some
# Productive types land in `deleted_items` and can be restored, and the API does
# not say which. Prefer the `archive` action where a resource has one.
# PRODUCTIVE_ENABLE_DELETES=true

# Narrow this instance to part of Productive. Comma-separated resource keys.
# A deny list wins over an allow list, and both apply to reads as well.
# PRODUCTIVE_ALLOWED_RESOURCES=tasks,time_entries,projects,services
# PRODUCTIVE_DENIED_RESOURCES=salaries,people

# A JSON file with the same fields (writesEnabled, financialsEnabled,
# adminEnabled, deletesEnabled, allowedResources, deniedResources). Overrides
# the variables above where present.
# PRODUCTIVE_POLICY_PATH=/etc/productive/policy.json

# --- Caller identity -------------------------------------------------------
# Read the X-MCP-User header and resolve it to a Productive person, so
# person-shaped writes (time entries, bookings) land on the caller rather than
# on the token's owner.
#
# Enable this ONLY behind a gateway that sets the header from a validated token
# AND strips any client-supplied copy. Without that, a caller can name anyone
# and log time as them.
# PRODUCTIVE_TRUST_FORWARDED_USER=true

# --- Audit -----------------------------------------------------------------
# One JSON line per mutation attempt, including the ones policy refused.
# Request bodies are deliberately not recorded: they carry salaries, rates and
# personal data.
# PRODUCTIVE_AUDIT_LOG=/data/audit.jsonl

# --- HTTP transport --------------------------------------------------------
# MCP_HTTP_HOST=127.0.0.1
# PORT=3000
# Shared bearer token for POST /mcp. /healthz stays open.
# MCP_HTTP_TOKEN=
# MCP_ALLOWED_ORIGINS=https://example.com
# MCP_ALLOW_ANY_ORIGIN=false
# MCP_MAX_BODY_BYTES=10485760
